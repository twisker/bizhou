#!/usr/bin/env bash
# Git pre-commit hook：自动同步版本号。
# 有"非版本文件"变更时，调用统一脚本 bump-version.sh 递增 patch
# （同时更新 VERSION 与所有 package.json，保持一致）。

STAGED_FILES=$(git diff --cached --name-only)

# 版本文件集合：VERSION + 根/各包 package.json。
# 若本次仅变更这些文件（如 minor/major 提交），跳过，避免二次 bump。
# 有意的取舍：仅改 package.json（如加依赖）也会被跳过、不自动 bump；此类改动请手动 bump。
NON_VERSION_FILES=$(echo "$STAGED_FILES" | grep -vE '^(VERSION|package\.json|packages/core/package\.json|packages/cli/package\.json)$' || true)
if [ -z "$NON_VERSION_FILES" ]; then
  exit 0
fi

SCRIPT_DIR="$(git rev-parse --show-toplevel)/scripts"
if [ -f "$SCRIPT_DIR/bump-version.sh" ]; then
  bash "$SCRIPT_DIR/bump-version.sh" patch
fi
